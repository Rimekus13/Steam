
# Apps Steam (séparés par virgule)
APP_IDS=526870

# --- Mongo local (pour ETL + dashboard sur ta machine) ---
MONGO_USER=steam
MONGO_PASS=steam
MONGO_DB=steamdb
MONGO_HOST=localhost
MONGO_PORT=27017

# local (Windows)
MONGO_URI=mongodb://root:example@localhost:27017/steamdb?authSource=admin

# dans les conteneurs (si tu utilises root/example)
MONGO_URI_DOCKER=mongodb://root:example@mongo:27017/steamdb?authSource=admin




# API tuning
STEAM_NUM_PER_PAGE=100
STEAM_FILTER=recent      # ou recent
STEAM_REVIEW_TYPE=all
STEAM_PURCHASE_TYPE=all
STEAM_LANGUAGE=all
STEAM_DAY_RANGE=30

