
# Apps Steam (séparés par virgule)
APP_IDS=3527290

# Mongo local (pour ETL + dashboard sur ta machine)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=steamdb

# Si les tâches tournent DANS Docker (Airflow) et Mongo est dans ce même docker-compose,
# alors les tâches utiliseront: mongodb://mongo:27017/ (voir docker-compose.yml)
MONGO_URI_DOCKER=mongodb://mongo:27017/

# API tuning
STEAM_NUM_PER_PAGE=100
STEAM_FILTER=all
STEAM_REVIEW_TYPE=all
STEAM_PURCHASE_TYPE=all
STEAM_LANGUAGE=all
STEAM_DAY_RANGE=3650
API_SLEEP_SECONDS=1.2
