# ================================
# Projet Steam — Configuration .env
# ================================

# --- Jeux ciblés (séparés par virgule)
APP_IDS=304390

# --- Base Mongo
MONGO_DB=steamdb

# --- Comptes applicatifs (à créer dans Mongo)
ETL_WRITER_PWD=CHANGE_ME_STRONG
DASH_READER_PWD=CHANGE_ME_STRONG

# --- Connexions Mongo
# Depuis la machine hôte
MONGO_URI=mongodb://etl_writer:${ETL_WRITER_PWD}@localhost:27017/${MONGO_DB}?authSource=${MONGO_DB}

# Depuis Docker (Airflow, etc.)
MONGO_URI_DOCKER=mongodb://etl_writer:${ETL_WRITER_PWD}@mongo:27017/${MONGO_DB}?authSource=${MONGO_DB}

# Dashboard (lecture seule)
DASH_MONGO_URI=mongodb://dashboard_reader:${DASH_READER_PWD}@mongo:27017/${MONGO_DB}?authSource=${MONGO_DB}

# Admin (debug uniquement, root/example)
ADMIN_MONGO_URI=mongodb://root:example@mongo:27017/${MONGO_DB}?authSource=admin

# --- API Steam
STEAM_NUM_PER_PAGE=100
STEAM_FILTER=updated
STEAM_REVIEW_TYPE=all
STEAM_PURCHASE_TYPE=all
STEAM_LANGUAGE=all
STEAM_DAY_RANGE=30
