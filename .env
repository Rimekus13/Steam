
# Apps Steam (séparés par virgule)
APP_IDS=1094390,2507950,230410

# --- Mongo local (pour ETL + dashboard sur ta machine) ---
MONGO_USER=steam
MONGO_PASS=steam
MONGO_DB=steamdb
MONGO_HOST=localhost
MONGO_PORT=27017

# URI complète (host Windows)
MONGO_URI=mongodb://steam:steam@localhost:27017/steamdb?authSource=steamdb

# URI quand ça tourne DANS Docker (Airflow/containers)
MONGO_URI_DOCKER=mongodb://steam:steam@mongo:27017/steamdb?authSource=steamdb


# API tuning
STEAM_NUM_PER_PAGE=100
STEAM_FILTER=all
STEAM_REVIEW_TYPE=recent
STEAM_PURCHASE_TYPE=all
STEAM_LANGUAGE=all
STEAM_DAY_RANGE=365
API_SLEEP_SECONDS=1.2
